# Copy to /etc/glass/panel-api-test.env on CT316.
# The HMAC placeholder below is rejected at startup.
# Do not put a prod Portal signing key here. Do not point JWKS at prod.
#
# Staff accept path: Portal OIDC RS256 only.
# Non-dot path: portal-test nginx returns 403 for /.well-known/*.
# This process does not discover OIDC metadata and does not mint Portal tokens.
# HS256 staff tokens are rejected even when the HMAC secret below is set.
PANEL_JWT_JWKS_URL=https://portal-test.glasshosting.internal/oidc/jwks.json
# Agent mint signing secret. Verifies panel-minted agent HS256 tokens only.
# Not a staff accept path. Same TEST iss/aud as RS256. Not Portal OIDC.
PANEL_ENV=test
PANEL_JWT_HMAC_SECRET=replace-with-test-hmac-secret
PANEL_JWT_ISS=https://portal-test.glasshosting.internal
PANEL_JWT_AUD=https://panel-api-test.glasshosting.internal
PANEL_PUBLIC_BASE_URL=https://panel-api-test.glasshosting.internal
# Leave LISTEN_ADDR unset here. The systemd unit sets 0.0.0.0:8080 for the
# underlay. Local runs should keep the binary default 127.0.0.1:8080.
#
# Phase B migrate dry_run. Names only. Do not put a token value in this file.
# GLASSPANEL_MIGRATE_ENABLED=true
# GLASSPANEL_MIGRATE_MODE_MAX=inventory_only
# PTERO_SOURCE_API_URL=
# PTERO_SOURCE_API_TOKEN=
# Phase A create. Defaults apply when these are unset. Do not point the
# allowlist at managed-inventory targets. The pool is a non-routable ULA,
# not a public address.
# PANEL_CREATE_NODE_ALLOWLIST=5
# GLASSPANEL_CREATE_NODE_ID=5
# PANEL_ALLOC_POOL=tor-n5-ula-test
# GLASSPANEL_ALLOC_POOL=tor-n5-ula-test
# Phase C. Default stays noop. Do not set real on TEST CT316 or prod in this
# file. That flip is a separate DevOps APPLY after merge. This example does not.
# PANEL_WINGS_EXECUTOR=noop
# Empty PANEL_WINGS_ALLOWLIST means zero Wings dials, even when executor=real.
# Clearance is UUID-narrow. A node id does not authorize a dial.
# Never list managed-inventory targets or `glassmc-dev-*` docker.
# PANEL_WINGS_ALLOWLIST=
# Wings daemon origin and bearer. Names only. Leave both empty. Do not put a
# token value here. Both empty: executor=real still boots, and an allowlisted
# power fails closed (502, Wings-Dispatch 0, not a success). Setting only one
# refuses to start. Redirects are not followed. The token is never logged.
# PANEL_WINGS_BASE_URL=
# PANEL_WINGS_TOKEN=
# Phase D2 file writes use the same executor, allowlist, and dial pair.
# They dial only for an allowlisted UUID, and only for a .jar or .zip under
# mods/ or plugins/. Managed-inventory targets stay denied. Do not set real here.
