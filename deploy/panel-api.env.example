# Copy to /etc/glass/panel-api.env on the prod host.
# The HMAC placeholder below is rejected at startup.
# Do not put a signing key in this file.
#
# Staff accept path: Portal OIDC RS256 only.
# This process does not discover OIDC metadata and does not mint Portal tokens.
# HS256 staff tokens are rejected even when the HMAC secret below is set.
# A day-1 local JWKS origin may replace the prod Portal URL below.
# Do not point JWKS at the test Portal. Do not use the public panel host.
PANEL_JWT_JWKS_URL=https://portal.glasshosting.com/oidc/jwks.json
PANEL_JWT_KID=ggp-prod-1
# Agent mint signing secret. Verifies panel-minted agent HS256 tokens only.
# Not a staff accept path. Same prod iss/aud as RS256. Not Portal OIDC.
PANEL_ENV=prod
PANEL_JWT_HMAC_SECRET=replace-with-prod-hmac-secret
PANEL_JWT_ISS=https://portal.glasshosting.com
PANEL_JWT_AUD=https://panel-api.glasshosting.internal
PANEL_PUBLIC_BASE_URL=https://panel-api.glasshosting.internal
# Leave LISTEN_ADDR unset here. The systemd unit sets 0.0.0.0:8080 for the
# underlay. Local runs should keep the binary default 127.0.0.1:8080.
#
# Phase B migrate dry_run. Names only. Do not put a token value in this file.
# GLASSPANEL_MIGRATE_ENABLED=true
# GLASSPANEL_MIGRATE_MODE_MAX=inventory_only
# PTERO_SOURCE_API_URL=
# PTERO_SOURCE_API_TOKEN=
# Create defaults apply when these are unset. Do not point the allowlist at
# managed-inventory targets. Node 1 is refused.
# PANEL_CREATE_NODE_ALLOWLIST=5
# GLASSPANEL_CREATE_NODE_ID=5
# PANEL_ALLOC_POOL=tor-n5-ula-test
# GLASSPANEL_ALLOC_POOL=tor-n5-ula-test
# Day-1 executor stays noop. Do not set real in this file.
# Leave the Wings origin and token empty. Setting either one refuses to start.
# PANEL_WINGS_EXECUTOR=noop
# PANEL_WINGS_ALLOWLIST=
# PANEL_WINGS_BASE_URL=
# PANEL_WINGS_TOKEN=
